---
interface Props {
  title: string;
}
const { title } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <h1>Multi-Agent Planning Evaluation Corpus</h1>
        <p>128 systems from a systematic survey of LLM-based multi-agent planning evaluation (2023-2026)</p>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
