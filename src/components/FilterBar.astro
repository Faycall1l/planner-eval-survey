---
import ExportButton from './ExportButton.astro';
---

<div class="toolbar">
  <select class="filter-select" id="classSelect" aria-label="Filter by class">
    <option value="">All Classes</option>
    <option value="1">Class 1: Formal Plan Validity</option>
    <option value="2">Class 2: Decomposition and Tool Orchestration</option>
    <option value="3">Class 3: Embodied and Interactive Execution</option>
    <option value="4">Class 4: Robustness and Recovery</option>
    <option value="5">Class 5: Efficiency and Cost</option>
    <option value="6">Class 6: Coordination Structure</option>
  </select>
  <select class="filter-select" id="yearSelect" aria-label="Filter by year">
    <option value="">All Years</option>
    <option value="2023">2023</option>
    <option value="2024">2024</option>
    <option value="2025">2025</option>
    <option value="2026">2026</option>
  </select>
  <select class="filter-select" id="venueSelect" aria-label="Filter by venue">
    <option value="">All Venues</option>
    <option value="peer">Peer-reviewed</option>
    <option value="preprint">Preprint</option>
  </select>
  <button class="btn" id="resetBtn">Reset</button>
  <ExportButton />
</div>

<script>
  const classSelect = document.getElementById('classSelect') as HTMLSelectElement;
  const yearSelect = document.getElementById('yearSelect') as HTMLSelectElement;
  const venueSelect = document.getElementById('venueSelect') as HTMLSelectElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;

  classSelect.addEventListener('change', () => window.dispatchEvent(new CustomEvent('filter')));
  yearSelect.addEventListener('change', () => window.dispatchEvent(new CustomEvent('filter')));
  venueSelect.addEventListener('change', () => window.dispatchEvent(new CustomEvent('filter')));

  resetBtn.addEventListener('click', () => {
    classSelect.value = '';
    yearSelect.value = '';
    venueSelect.value = '';
    window.dispatchEvent(new CustomEvent('filter'));
  });
</script>
