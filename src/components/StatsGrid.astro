---
interface Paper {
  pid: string;
  name: string;
  cls: string;
  year: string;
  venue: string;
}

interface Props {
  papers: Paper[];
}

const { papers } = Astro.props;
const peer = papers.filter(p => p.venue && !p.venue.toLowerCase().includes('arxiv')).length;
const preprints = papers.length - peer;
const years = [...new Set(papers.map(p => p.year))].sort();
---

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value">{papers.length}</div>
    <div class="stat-label">Papers</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{peer}</div>
    <div class="stat-label">Peer-reviewed</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{preprints}</div>
    <div class="stat-label">Preprints</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{years.length}</div>
    <div class="stat-label">Years</div>
  </div>
</div>
