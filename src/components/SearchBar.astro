<div class="toolbar">
  <input
    type="text"
    class="search-input"
    id="searchInput"
    placeholder="Search papers, benchmarks, findings..."
    aria-label="Search papers"
  />
</div>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  searchInput.addEventListener('input', () => {
    window.dispatchEvent(new CustomEvent('search', { detail: searchInput.value }));
  });
</script>
